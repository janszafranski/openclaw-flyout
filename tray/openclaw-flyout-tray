#!/usr/bin/env python3
"""
OpenClaw flyout tray applet — a persistent system-tray (StatusNotifierItem)
"AI" indicator that launches / closes the OpenClaw flyout with a mouse.

Appears in the Caelestia bar tray (or any SNI host). Left-click or the menu
toggles the flyout via its Quickshell IPC. The icon is FILLED white when the
flyout is open and an OUTLINE when closed.

Runs as its own GTK3 + Ayatana AppIndicator process (mirrors the shakefree-mouse
tray). No system files touched — upgrade-proof.

State detection: the flyout maps a layer-shell surface named "openclaw-sidebar";
it is present in `hyprctl layers` only while the flyout is shown. We poll that.
"""
import os, signal, subprocess, sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, GLib, AyatanaAppIndicator3 as AppIndicator3

HOME     = os.path.expanduser("~")
SELF_DIR = os.path.dirname(os.path.abspath(__file__))
ICONDIR  = os.path.join(SELF_DIR, "icons")
ICON_ON, ICON_OFF = "openclaw-ai-on", "openclaw-ai-off"
SIDEBAR_NS = "openclaw-sidebar"

# The flyout runs on wayland-1; qs IPC needs WAYLAND_DISPLAY set to find it.
ENV = dict(os.environ)
ENV.setdefault("WAYLAND_DISPLAY", "wayland-1")


def _hypr_sig():
    """Newest Hyprland instance signature (for hyprctl), or '' if none."""
    d = f"/run/user/{os.getuid()}/hypr"
    try:
        sigs = sorted(os.listdir(d), key=lambda s: os.path.getmtime(os.path.join(d, s)))
        return sigs[-1] if sigs else ""
    except Exception:
        return ""


def flyout_open():
    """True if the flyout's layer surface is currently mapped."""
    env = dict(ENV); sig = _hypr_sig()
    if sig:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    try:
        out = subprocess.run(["hyprctl", "layers"], env=env,
                             capture_output=True, text=True, timeout=3).stdout
        return SIDEBAR_NS in out
    except Exception:
        return False


def ipc(fn):
    """Call a flyout IPC function.

    NOTE: "show" is unusable as a function name here — `qs ipc show` is a
    reserved subcommand (list endpoints), so `ipc call sidebar show` is parsed
    as the list command and never invokes show(). We therefore drive open/close
    with `toggle` (flips reliably) and the working `hide`, gated on live state.
    """
    try:
        subprocess.run(["qs", "-c", "openclaw-sidebar", "ipc", "call", "sidebar", fn],
                       env=ENV, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def set_flyout(want_open):
    """Drive the flyout to the requested state, avoiding the broken show()."""
    is_open = flyout_open()
    if want_open == is_open:
        return
    if want_open:
        ipc("toggle")          # closed -> open
    else:
        ipc("hide")            # hide() works directly


class Tray:
    def __init__(self):
        self.ind = AppIndicator3.Indicator.new_with_path(
            "openclaw-flyout", ICON_OFF,
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS, ICONDIR)
        self.ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.ind.set_title("OpenClaw AI")

        self.menu = Gtk.Menu()
        self.item_toggle = Gtk.CheckMenuItem(label="Show AI flyout")
        self.item_toggle.connect("toggled", self.on_toggle)
        self.menu.append(self.item_toggle)
        self.menu.append(Gtk.SeparatorMenuItem())
        item_quit = Gtk.MenuItem(label="Quit tray")
        item_quit.connect("activate", lambda *_: Gtk.main_quit())
        self.menu.append(item_quit)
        self.menu.show_all()
        self.ind.set_menu(self.menu)
        # Left-click (secondary activate) toggles directly on hosts that support it.
        self.ind.set_secondary_activate_target(self.item_toggle)

        self._syncing = False
        self._last = None
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)

    def on_toggle(self, item):
        if self._syncing:
            return
        # Drive to the requested state (open/close), not a blind toggle,
        # so the checkbox and the flyout can't drift out of sync.
        set_flyout(item.get_active())
        GLib.timeout_add(400, self.refresh)

    def refresh(self):
        on = flyout_open()
        if on != self._last:
            self.ind.set_icon_full(ICON_ON if on else ICON_OFF,
                                   "AI flyout " + ("open" if on else "closed"))
            self._last = on
        self._syncing = True
        self.item_toggle.set_active(on)
        self.item_toggle.set_label("Hide AI flyout" if on else "Show AI flyout")
        self._syncing = False
        return True


if __name__ == "__main__":
    signal.signal(signal.SIGINT, lambda *_: Gtk.main_quit())
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    Tray()
    Gtk.main()
